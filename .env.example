# ============================================================
# TechFix - Variables de entorno de ejemplo
# Copiar este archivo como .env y completar los datos locales.
# El archivo .env real NO se sube al repositorio (.gitignore).
# ============================================================

APP_NAME="TechFix"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/techfix
APP_TIMEZONE=America/Argentina/Buenos_Aires

SUPPORT_EMAIL=soporte@techfix.com.ar
SUPPORT_PHONE=+54 11 5555-0101
WHATSAPP=5491155550101
SHOP_ADDRESS="Av. Rivadavia 1234, CABA"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=techfix_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Clave usada para firmar el token CSRF de los formularios.
APP_KEY=cambiar-esta-clave-por-una-propia
